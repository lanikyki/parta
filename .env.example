# Скопируйте этот файл в .env.local (на своём компьютере) или в .env (на сервере с Docker)
# и заполните значения. Файлы .env* с ключами НИКОГДА не загружайте в GitHub.

# --- Видео (LiveKit) ---
# На своём компьютере: запустите `livekit-server --dev` и оставьте значения ниже как есть.
# LiveKit Cloud: возьмите URL и ключи в кабинете cloud.livekit.io (Settings → Keys).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Необязательно: адрес видеосервера для браузера, если он отличается от LIVEKIT_URL
LIVEKIT_PUBLIC_URL=

# --- База данных ---
# Пусто = встроенная база в папке ./data (подходит для своего сервера).
# Для Vercel и других облаков нужна строка подключения PostgreSQL (Neon, Supabase и т.п.).
DATABASE_URL=
# Папка встроенной базы (по умолчанию ./data/db)
PGLITE_DIR=

# --- ИИ-помощник (любой OpenAI-совместимый сервис) ---
# Пример для DeepSeek: AI_BASE_URL=https://api.deepseek.com
AI_BASE_URL=
AI_API_KEY=
# Модель для конспектов и подробных ответов
AI_MODEL_SMART=
# Быстрая модель для подсказок (можно оставить пустым — возьмётся AI_MODEL_SMART)
AI_MODEL_FAST=

# --- Администратор ---
# Ваша почта (можно несколько через запятую). Этим людям доступна админка: страница /admin
# с заявками, пользователями и журналом событий. Почта должна совпадать с почтой аккаунта на сайте.
ADMIN_EMAILS=

# --- Почта (коды подтверждения при регистрации и смене пароля) ---
# Пока не заполнено, письма не уходят: код показывается на странице (при запуске на своём компьютере)
# и пишется в чёрном окне сервера. Подойдёт обычный ящик на Яндексе, Mail.ru или Gmail.
# Нужен не обычный пароль, а «пароль приложения» (как его получить — README, раздел «Почта»).
# Яндекс: id.yandex.ru → Безопасность → Пароли приложений → «Почта».
SMTP_USER=
SMTP_PASS=
# Сервер почты. Для Яндекса, Mail.ru, Gmail и Rambler можно не заполнять — подставится сам.
SMTP_HOST=
# Порт: пусто = 465 (защищённое соединение), а если он закрыт — сайт сам попробует 587.
SMTP_PORT=
# От чьего имени письма. Пусто = «Парта <SMTP_USER>». Можно просто имя: MAIL_FROM=Парта
MAIL_FROM=

# --- Тестовый режим на сервере ---
# Пока не подключены ЮKassa и звонки, оплата проходит тестовыми картами (деньги не списываются),
# а код подтверждения телефона показывается прямо на странице. На своём компьютере это включено само.
# На сервере включайте только для проверки (TEST_MODE=1) — и выключите, когда придут настоящие пользователи.
TEST_MODE=

# --- Оплата подписок (ЮKassa) ---
# Личный кабинет ЮKassa → Интеграция → Ключи API: shopId и секретный ключ.
# Там же → HTTP-уведомления: адрес https://ваш-домен/api/billing/webhook,
# события payment.succeeded, payment.canceled и refund.succeeded.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Автопродление (сохранение карты): впишите 1, когда ЮKassa включит магазину автоплатежи
YOOKASSA_RECURRING=
# Чеки по 54-ФЗ («Чеки от ЮKassa» или своя онлайн-касса): 1 — передавать данные для чека
YOOKASSA_RECEIPTS=
# Ставка НДС в чеке: 1 — без НДС (обычно у ИП на УСН). Другие коды — в документации ЮKassa
YOOKASSA_VAT_CODE=
# Система налогообложения в чеке: 1 — ОСН, 2 — УСН «доходы», 3 — УСН «доходы минус расходы», 6 — патент.
# Пусто — как в настройках магазина в ЮKassa
YOOKASSA_TAX_SYSTEM=

# --- Подтверждение телефона звонком (SMS.ru) ---
# Нужно для пробного урока и перед первой оплатой. Сайт звонит, человек вводит 4 последние цифры номера.
# Для человека звонок бесплатный, сайт платит SMS.ru по их тарифу. sms.ru → кабинет → «Программистам» → api_id
SMSRU_API_ID=
# Сколько звонков в сутки на весь сайт (защита баланса SMS.ru). Пусто — 300
PHONE_DAILY_LIMIT=

# --- Реквизиты для оферты и страницы «Контакты и реквизиты» ---
# Заполните до приёма оплаты. Пока пусто, в документах написано, что реквизиты появятся позже.
# Например: Индивидуальный предприниматель Иванова Анна Сергеевна
LEGAL_NAME=
LEGAL_INN=
LEGAL_OGRNIP=
# Почта для вопросов и претензий (пусто — первая почта из ADMIN_EMAILS)
LEGAL_EMAIL=
LEGAL_PHONE=
# Адрес (можно только город, если не хотите публиковать полный адрес)
LEGAL_ADDRESS=
# Дата редакции документов, например: 1 декабря 2026
LEGAL_UPDATED=

# --- Ссылка для друга (share-windows.bat) ---
# Пусто = сервис выбирается сам: сначала Tuna (российский, ссылка постоянная, нужен бесплатный аккаунт —
# при первом запуске откроется страница входа), если не вышло — Cloudflare, Tunnelmole, Pinggy.
# Каждую ссылку скрипт проверяет и, если связь пропала, переподключается сам.
# Впишите SHARE_SERVICE=cloudflare (или tunnelmole, pinggy), чтобы начинать с другого сервиса — например, без аккаунта Tuna.
SHARE_SERVICE=
# Видео при показе другу. Пусто = видеосервер работает прямо на вашем компьютере и идёт через ту же ссылку:
# VPN и LiveKit Cloud не нужны (подробно — в README, раздел «Видео без VPN»).
# SHARE_VIDEO=cloud — взять видеосервер из LIVEKIT_URL выше (например, LiveKit Cloud).
SHARE_VIDEO=

# --- Только для теста по http (без https) на сервере ---
# INSECURE_COOKIES=1

# --- Только для docker-compose (вариант Б в README) ---
# Домен сайта и поддомен для видеосервера (оба должны указывать на IP сервера)
DOMAIN=
LIVEKIT_DOMAIN=

# --- Резервные копии (deploy/backup.sh) ---
# Папка для копий на сервере (пусто = /root/parta-backups) и сколько последних копий хранить
BACKUP_DIR=
BACKUP_KEEP=14
# Куда ещё отправлять копии, чтобы они пережили смерть сервера: подключение rclone и папка,
# например BACKUP_REMOTE=yadisk:parta-backups (как настроить Яндекс Диск, написано в начале deploy/backup.sh)
BACKUP_REMOTE=
